{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Shortener": {
    "BaseUrl": "http://localhost:5080",
    "CodeLength": 7,
    "MaxCodeGenerationAttempts": 5,
    "MaxUrlLength": 2048,
    "MaxExpiryDays": 365,
    "AnalyticsSalt": "dev-only-salt",
    "BlockedHosts": [ "localhost" ]
  },
  "Storage": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=urlshortener.db"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Security": {
    "ApiKey": ""
  }
}
